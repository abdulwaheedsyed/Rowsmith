-- Cassandra and ScyllaDB dev data (dev/compose.yaml creates the shop keyspace and the
-- engine-specific indexes first). Generated deterministically; edit freely.
USE shop;

CREATE TYPE address (street text, city text, zip text);

CREATE TABLE customers (
  id uuid PRIMARY KEY, name text, email text, tier text, signed_up timestamp,
  tags set<text>, address frozen<address>, prefs map<text, text>, balance decimal
) WITH comment = 'Customers, one partition each';

CREATE TABLE orders_by_customer (
  customer_id uuid, placed_at timestamp, order_id timeuuid, status text, total decimal,
  items list<text>, note text, channel text static,
  PRIMARY KEY ((customer_id), placed_at, order_id)
) WITH CLUSTERING ORDER BY (placed_at DESC, order_id ASC) AND comment = 'Orders, newest first within each customer';

CREATE TABLE sensor_readings (
  sensor_id text, day date, ts timestamp, value double, ok boolean,
  PRIMARY KEY ((sensor_id, day), ts)
) WITH default_time_to_live = 0 AND compaction = {'class': 'TimeWindowCompactionStrategy', 'compaction_window_unit': 'DAYS', 'compaction_window_size': 1};

CREATE TABLE page_views (page text PRIMARY KEY, views counter);

CREATE MATERIALIZED VIEW orders_by_status AS
  SELECT status, customer_id, placed_at, order_id, total FROM orders_by_customer
  WHERE status IS NOT NULL AND customer_id IS NOT NULL AND placed_at IS NOT NULL AND order_id IS NOT NULL
  PRIMARY KEY ((status), customer_id, placed_at, order_id);

